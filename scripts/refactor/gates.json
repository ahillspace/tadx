{
  "schema_version": 1,
  "source_baseline": "dd22c33bd1d123066f25ec09e2d612cd95717400",
  "scope": "Initial selected G1-G4 contract checks with isolated defect demonstrations; not full refactor acceptance.",
  "checks": [
    {
      "id": "g1-cli",
      "gate": "G1",
      "package": "./internal/app",
      "tests": [
        "TestRunCapabilityListRendersTOON",
        "TestRunCapabilityListRendersJSON",
        "TestRunJSONUsageErrorIsOneDocumentWithoutNotice",
        "TestRunJSONFlagLastValueAndAlias"
      ],
      "contract": "Existing TOON golden, JSON parseability, nonzero usage exit, exactly one JSON error document, and flag precedence. JSON parseability is not an exact key-set assertion."
    },
    {
      "id": "g1-projection",
      "gate": "G1",
      "package": "./actions/workbook",
      "tests": [
        "TestDeleteOutputGolden"
      ],
      "contract": "Exact compact and full TOON projections, including field omission."
    },
    {
      "id": "g2-cli",
      "gate": "G2",
      "package": "./internal/app",
      "tests": [
        "TestWorkbookDeletePreviewAndApplyThroughCLI",
        "TestProjectMoveUsesOneHierarchyPerValidationPhase",
        "TestContentMovesShareSourceAndDestinationHierarchyWithinPhase",
        "TestManagedPolicyPreviewNeedsCapabilityButNotRemotePermission"
      ],
      "contract": "Fake native HTTP delete/write counts, plan/prewrite hierarchy phases, changed source refusal, and managed policy preview behavior."
    },
    {
      "id": "g2-action",
      "gate": "G2",
      "package": "./actions/workbook",
      "tests": [
        "TestDeleteDeletePreviewsWithoutMutation",
        "TestDeleteDeleteRejectsAuthoritativeIdentityChange"
      ],
      "contract": "Preview performs one resolution and no writes; changed authoritative LUID prevents deletion."
    },
    {
      "id": "g3-cli",
      "gate": "G3",
      "package": "./internal/app",
      "tests": [
        "TestAdminUserUpdateRejectsPartialAcknowledgementThroughCLI",
        "TestAdminUserUpdateVerificationCasesThroughCLI",
        "TestAdminUserUpdatePartialReceiptFormatsThroughCLI",
        "TestAdminUserUpdateSubmittedFailureRetainsUnknownOutcomeThroughCLI"
      ],
      "contract": "HTTP success with unchanged requested attributes is not full success. Preserve partial/unknown outcomes, confirmed identity, request ID, and failed field."
    },
    {
      "id": "g4-state",
      "gate": "G4",
      "package": "./internal/app",
      "tests": [
        "TestAuthCredentialStoreLogoutRestoresReferenceWhenDeletionFails",
        "TestAuthCredentialStorePersistsOpaqueReferenceAndReplacesOldPAT",
        "TestAuthCredentialStoreLogoutDeletesPATAndReference",
        "TestEnvironmentPreviewValidatesWithoutChangingConfiguration",
        "TestAuthLogoutPreviewPreservesCredentialsThenExecutionRemovesOnlySelectedReference"
      ],
      "contract": "Real test-owned config plus fake credential store state; compensation and preview effects. Does not establish OS keyring or Unix durability-failure behavior."
    }
  ],
