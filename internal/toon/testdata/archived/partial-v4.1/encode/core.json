{
  "version": "4.1",
  "category": "encode",
  "description": "Pinned TOON 4.1 encoder conformance fixtures",
  "tests": [
    {
      "name": "quotes ambiguous and structural strings",
      "input": {"empty":"","bool":"true","number":"05","hash":"#x","colon":"a:b"},
      "expected": "empty: \"\"\nbool: \"true\"\nnumber: \"05\"\nhash: \"#x\"\ncolon: \"a:b\"",
      "specSection": "7.2"
    },
    {
      "name": "escapes the required control characters",
      "input": {"value":"a\\b\n\t\r\u0004\""},
      "expected": "value: \"a\\\\b\\n\\t\\r\\u0004\\\"\"",
      "specSection": "7.1"
    },
    {
      "name": "encodes a tabular array",
      "input": {"users":[{"id":1,"name":"Ada"},{"name":"Bob","id":2}]},
      "expected": "users[2]{id,name}:\n  1,Ada\n  2,Bob",
      "specSection": "9.3"
    },
    {
      "name": "encodes nested field groups",
      "input": {"users":[{"id":1,"customer":{"name":"Ada","country":"UK"}},{"customer":{"country":"US","name":"Bob"},"id":2}]},
      "expected": "users[2]{id,customer{name,country}}:\n  1,Ada,UK\n  2,Bob,US",
      "specSection": "9.3"
    },
    {
      "name": "encodes a keyed table",
      "input": {"users":{"alice":{"id":1,"role":"admin"},"bob":{"role":"user","id":2}}},
      "expected": "users[2:]{id,role}:\n  alice: 1,admin\n  bob: 2,user",
      "specSection": "9.5"
    },
    {
      "name": "uses pipe delimiter",
      "input": {"tags":["a,b","x|y"]},
      "expected": "tags[2|]: a,b|\"x|y\"",
      "options": {"delimiter":"|"},
      "specSection": "11"
    }
  ]
}
